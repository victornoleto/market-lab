# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Books — raw PDFs are NOT committed (copyright + size).
# Extracted text is derivable via scripts/extract_pdfs.py.
books/raw/
books/extracted/

# Partial summaries generated during map-reduce (only final summaries are versioned)
books/summaries/.partials/

# Secrets
.env
.env.local

# Ad-hoc screenshots / scratch captured during sessions
prints/

# Personal drafts (Reddit posts, untracked notes) — not part of the project.
docs/POST_reddit.md

# Tiingo bulk dataset (Phase 2.5 Run 3) — heavy parquet files NOT committed,
# but the manifest IS committed so collaborators see what's been downloaded.
data/tiingo/prices/
data/tiingo/meta/
data/tiingo/*.tar.gz
data/tiingo/bulk_summary_*.json
!data/tiingo/manifest.json

# Local caches for external data sources (yfinance parquet, wikipedia HTML)
.cache/

# Auto-generated backtest reports (regenerate via scripts/run_*_replication.py).
# Hand-written docs under reports/ (e.g. clenow_replication_notes.md) are committed.
reports/*_[0-9]*.md
reports/assets/
reports/grid_*/

# Live script logs (Fase 2.5 grid + future long-running jobs).
# Single unified log at logs/grid.log captures every run; per-run detail
# stays under .cache/grid_runs/ (already covered by .cache/ above).
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude Code local session state (ScheduleWakeup locks, etc.)
.claude/
books/summaries/.validation/
books/summaries/.logs/
books/summaries/.progress.json
books/summaries/.progress.log
books/summaries/.progress.*.json.done

# Defensive — secrets
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
*.token

# Defensive — heavy data artefacts
*.parquet
*.pkl
*.joblib
*.h5
*.npz
*.sqlite
*.sqlite3
db/*.sqlite*
db/*.db

# Defensive — Jupyter (se surgir)
*.ipynb
.ipynb_checkpoints/

# Defensive — Python extras
.mypy_cache/
.tox/
.coverage
htmlcov/
