{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "letf_rotation_hunt loop verdict",
  "description": "Schema for loop_iterations/NNN-*/verdict.json. Relaxed iter pattern + free-form tier (post-close hunt may explore non-LETF-rotation strategies). Adds beats_winner / sortino_edge_vs_winner / winner_benchmark_sortino fields.",
  "type": "object",
  "required": [
    "iter", "tier", "hypothesis", "primary_citation", "datetime_utc",
    "configs_tested", "datasets", "results", "best_config", "best_score",
    "best_tier", "kill_rule_status",
    "cumulative_n_trials_local", "cumulative_n_trials_loop",
    "cumulative_n_trials_global",
    "sortino_lh56y", "winner_conditions_met",
    "pct_time_above_benchmark_lh56y", "beats_winner",
    "sortino_edge_vs_winner", "winner_benchmark_sortino",
    "beats_winner_threshold_sortino", "winner_benchmark_iter",
    "winner_benchmark_config"
  ],
  "properties": {
    "iter": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+$"},
    "tier": {"type": "string"},
    "hypothesis": {"type": "string"},
    "primary_citation": {"type": "string", "pattern": "^\\[[^\\]]+\\]$"},
    "datetime_utc": {"type": "string"},
    "engine_version": {"type": "string"},
    "configs_tested": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object"}},
    "datasets": {"type": "array", "items": {"type": "string"}},
    "windows_used": {"type": "object"},
    "results": {"type": "array", "items": {"type": "object"}},
    "best_config": {"type": "string"},
    "best_score": {"type": "number"},
    "best_tier": {"type": "string"},
    "kill_rule_status": {"enum": ["PASS", "FIRES", "N/A"]},
    "cumulative_n_trials_local": {"type": "integer", "minimum": 0},
    "cumulative_n_trials_loop": {"type": "integer", "minimum": 0},
    "cumulative_n_trials_global": {"type": "integer", "minimum": 426},
    "synth_parity_pass": {"type": "boolean"},
    "sortino_lh56y": {"type": "number"},
    "winner_conditions_met": {"type": "boolean"},
    "pct_time_above_benchmark_lh56y": {"type": "number", "minimum": 0, "maximum": 1},
    "beats_winner": {"type": "boolean"},
    "sortino_edge_vs_winner": {"type": "number"},
    "winner_benchmark_sortino": {"type": "number", "const": 1.3246},
    "beats_winner_threshold_sortino": {"type": "number", "const": 1.3746},
    "winner_benchmark_iter": {"type": "string"},
    "winner_benchmark_config": {"type": "string"}
  }
}
