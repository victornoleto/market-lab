{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "letf_rotation_hunt verdict",
  "type": "object",
  "required": [
    "iter", "tier", "hypothesis", "primary_citation", "datetime_utc",
    "configs_tested", "datasets", "results", "best_config", "best_score",
    "best_tier", "kill_rule_status", "advance_to_next_tier",
    "cumulative_n_trials_at_iter", "cumulative_n_trials_local",
    "deploy_escalation_eligible", "synth_parity_pass"
  ],
  "properties": {
    "iter": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}-T[0-9][a-z]?-.*$"},
    "tier": {"type": "string", "pattern": "^T[0-9][a-z]?$"},
    "tier_inheritance": {
      "type": ["object", "null"],
      "properties": {
        "from_tier": {"type": ["string", "null"]},
        "inherited_config_name": {"type": ["string", "null"]},
        "kill_fallback": {"type": "boolean"}
      }
    },
    "hypothesis": {"type": "string"},
    "primary_citation": {"type": "string"},
    "datetime_utc": {"type": "string"},
    "engine_version": {"type": "string"},
    "configs_tested": {"type": "array", "items": {"type": "object"}},
    "datasets": {"type": "array", "items": {"type": "string"}},
    "windows_used": {"type": "object"},
    "results": {"type": "array", "items": {"type": "object"}},
    "best_config": {"type": "string"},
    "best_score": {"type": "number"},
    "best_tier": {"type": "string"},
    "kill_rule_status": {"enum": ["PASS", "FIRES", "N/A"]},
    "advance_to_next_tier": {"type": "boolean"},
    "cumulative_n_trials_at_iter": {"type": "integer", "minimum": 0},
    "cumulative_n_trials_local": {"type": "integer", "minimum": 0},
    "deploy_escalation_eligible": {"type": "boolean"},
    "synth_parity_pass": {"type": "boolean"}
  }
}
