# ai-trade — environment template
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored.
#
# Phases 1+ stack: cTrader Open API (Protobuf over TCP + OAuth2) via Pepperstone.
# Endpoints are the same for demo and live; only the account ID and host change.

# =============================================================================
# cTrader Open API — OAuth2 credentials (Spotware developer portal)
# =============================================================================
# Fill these FIRST, manually, from the app you register at openapi.ctrader.com.
# See: https://help.ctrader.com/open-api/account-authentication/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Redirect URI — must match EXACTLY what you registered in the app settings.
# Recommended for local bootstrap: http://localhost:8080/callback
# If Spotware rejects localhost, use an ngrok/SSH tunnel URL instead and set it here.
CTRADER_REDIRECT_URI=http://localhost:8080/callback

# Scope — use "trading" for full access (trading + account info).
# Use "accounts" for read-only if you only want account data.
CTRADER_SCOPE=trading

# =============================================================================
# cTrader Open API — tokens (written by scripts/ctrader_oauth_bootstrap.py)
# =============================================================================
# DO NOT fill these manually. The bootstrap script captures them via browser.
#
# IMPORTANT: refresh tokens are ROTATING — every call to the refresh endpoint
# returns a NEW refresh_token and invalidates the old one. The app must
# persist the new refresh_token atomically (see Phase 1 design notes).
# Lifetime: the refresh token itself does not expire (but is invalidated on rotation).
# Access token lifetime: ~30 days (subject to change; confirm empirically).
CTRADER_REFRESH_TOKEN=
CTRADER_ACCESS_TOKEN=

# =============================================================================
# cTrader Open API — accounts
# =============================================================================
# Fetched via ProtoOAGetAccountsByAccessTokenReq after first OAuth.
# A cTID may have multiple linked accounts (demo + live at Pepperstone, plus
# any other broker linked to the same cTID).
CTRADER_DEMO_ACCOUNT_ID=
CTRADER_LIVE_ACCOUNT_ID=

# =============================================================================
# cTrader Open API — transport
# =============================================================================
# Protobuf over TCP. Same port for demo and live; host differs.
CTRADER_HOST_DEMO=demo.ctraderapi.com
CTRADER_HOST_LIVE=live.ctraderapi.com
CTRADER_PORT=5035

# Active mode for the app: "demo" or "live". Controls which host + account ID are used.
CTRADER_MODE=demo

# =============================================================================
# Postgres (Phase 1 docker-compose will provision this)
# =============================================================================
DATABASE_URL=postgresql://ai_trade:ai_trade@localhost:5432/ai_trade
